<Window x:Class="Zonic.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zonic Settings" Height="660" Width="540" MinHeight="420" MinWidth="460"
        WindowStyle="None" Background="#1c1c1e" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" Background="#1c1c1e">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="Header" Grid.Row="0" Background="#1c1c1e" MouseLeftButtonDown="Header_MouseDown">
      <Grid Margin="20,0,12,0">
        <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="#f2f2f7"
                   VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Content="&#xE711;"
                FontFamily="Segoe MDL2 Assets" FontSize="12" Width="32" Height="28"
                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
      <StackPanel>
        <TextBlock x:Name="AppearanceHeading" Text="APPEARANCE" FontSize="10" FontWeight="Bold"
                   Foreground="#928374" Margin="0,8,0,8" />
        <TextBlock Text="Theme" FontSize="12" Foreground="#ebdbb2" Margin="0,0,0,4" />
        <ComboBox x:Name="ThemeCombo" Height="28" Margin="0,0,0,12"
                  SelectionChanged="Theme_Changed" />
        <TextBlock Text="Amazon page" FontSize="12" Foreground="#ebdbb2" Margin="0,0,0,4" />
        <ComboBox x:Name="SkinCombo" Height="28" Margin="0,0,0,6"
                  SelectionChanged="Skin_Changed" />
        <TextBlock Text="Tint repaints the page from the palette. Invert flips the whole page and re-inverts images, which works on any markup but is blunter."
                   FontSize="11" Foreground="#928374" TextWrapping="Wrap" Margin="0,0,0,18" />

        <TextBlock Text="PLAYBACK" FontSize="10" FontWeight="Bold" Foreground="#928374" Margin="0,0,0,8" />
        <CheckBox x:Name="SeekCheck" Content="Allow seeking and skipping with the scrubber"
                  Foreground="#ebdbb2" FontSize="12" Margin="0,0,0,8" Checked="Seek_Changed" Unchecked="Seek_Changed" />
        <CheckBox x:Name="FinishCheck" Content="If a skip is refused, end the track so the queue moves on"
                  Foreground="#ebdbb2" FontSize="12" Margin="0,0,0,8" Checked="Finish_Changed" Unchecked="Finish_Changed" />
        <TextBlock Text="Crossfade" FontSize="12" Foreground="#ebdbb2" Margin="0,4,0,4" />
        <ComboBox x:Name="CrossfadeCombo" Height="28" Margin="0,0,0,6"
                  SelectionChanged="Crossfade_Changed" />
        <TextBlock Text="Amazon limits skipping per hour on its side, so this cannot lift that. The fade is a fade out then a fade in, because two DRM streams cannot play at once."
                   FontSize="11" Foreground="#928374" TextWrapping="Wrap" Margin="0,0,0,18" />

        <TextBlock Text="LAST.FM" FontSize="10" FontWeight="Bold" Foreground="#928374" Margin="0,0,0,8" />
        <TextBlock Text="API key" FontSize="12" Foreground="#ebdbb2" Margin="0,0,0,4" />
        <TextBox x:Name="KeyBox" Height="26" Margin="0,0,0,8" />
        <TextBlock Text="Shared secret" FontSize="12" Foreground="#ebdbb2" Margin="0,0,0,4" />
        <PasswordBox x:Name="SecretBox" Height="26" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="ConnectButton" Content="Connect" Width="110" Height="28" Margin="0,0,8,0"
                  Click="Connect_Click" />
          <Button x:Name="FinishButton" Content="Finish Connecting" Width="140" Height="28" Margin="0,0,8,0"
                  Click="Finish_Click" />
          <Button x:Name="DisconnectButton" Content="Disconnect" Width="100" Height="28"
                  Click="Disconnect_Click" />
        </StackPanel>
        <CheckBox x:Name="LastfmCheck" Content="Scrobble what I play"
                  Foreground="#ebdbb2" FontSize="12" Margin="0,0,0,8"
                  Checked="Lastfm_Changed" Unchecked="Lastfm_Changed" />
        <TextBlock x:Name="LastfmStatus" Text="" FontSize="11" Foreground="#928374"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button x:Name="TestButton" Content="Send Test Scrobble" Width="160" Height="28"
                HorizontalAlignment="Left" Margin="0,0,0,6" Click="Test_Click" />
        <TextBlock Text="Create an API account at last.fm/api/account/create, paste the key and secret here, then Connect."
                   FontSize="11" Foreground="#928374" TextWrapping="Wrap" Margin="0,0,0,18" />

        <TextBlock Text="UPDATES" FontSize="10" FontWeight="Bold" Foreground="#928374" Margin="0,0,0,8" />
        <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates when Zonic starts"
                  Foreground="#ebdbb2" FontSize="12" Margin="0,0,0,8"
                  Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="CheckNowButton" Content="Check for Updates" Width="150" Height="28" Margin="0,0,12,0"
                  Click="CheckNow_Click" />
          <TextBlock x:Name="VersionText" Text="" FontSize="11" Foreground="#928374"
                     VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
