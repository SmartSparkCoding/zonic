<Window x:Class="Zonic.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyrics" Height="720" Width="1080" MinHeight="420" MinWidth="720"
        WindowStyle="None" Background="#1c1c1e" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" Background="#1c1c1e" MouseLeftButtonDown="Root_MouseDown">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Margin="40,56,24,40" VerticalAlignment="Top">
      <Border Width="240" Height="240" CornerRadius="12" Background="#2c2c2e"
              HorizontalAlignment="Left">
        <Border.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
          <TextBlock x:Name="ArtworkPlaceholder" Text="&#x266B;" FontSize="64"
                     Foreground="#55ffffff" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image x:Name="Artwork" Stretch="UniformToFill" />
        </Grid>
      </Border>

      <TextBlock x:Name="TitleText" Text="" FontSize="21" FontWeight="SemiBold"
                 Foreground="#f2f2f7" TextWrapping="Wrap" Margin="0,22,0,0" />
      <TextBlock x:Name="ArtistText" Text="" FontSize="14" Foreground="#98989f"
                 TextWrapping="Wrap" Margin="0,4,0,0" />

      <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#33ffffff" Margin="0,22,0,0">
        <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Background="#0a84ff"
                HorizontalAlignment="Left" Width="0" />
      </Border>
      <Grid Margin="0,6,0,0">
        <TextBlock x:Name="ElapsedText" Text="0:00" FontSize="11" FontFamily="Consolas"
                   Foreground="#98989f" HorizontalAlignment="Left" />
        <TextBlock x:Name="RemainingText" Text="-0:00" FontSize="11" FontFamily="Consolas"
                   Foreground="#98989f" HorizontalAlignment="Right" />
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
        <Button x:Name="PreviousButton" Style="{StaticResource ChromeButton}" Content="&#xE892;"
                FontFamily="Segoe MDL2 Assets" FontSize="16" Width="40" Height="34"
                Click="Previous_Click" ToolTip="Previous" />
        <Button x:Name="PlayButton" Style="{StaticResource ChromeButton}" Content="&#xE768;"
                FontFamily="Segoe MDL2 Assets" FontSize="20" Width="48" Height="40"
                Click="Play_Click" ToolTip="Play or pause" />
        <Button x:Name="NextButton" Style="{StaticResource ChromeButton}" Content="&#xE893;"
                FontFamily="Segoe MDL2 Assets" FontSize="16" Width="40" Height="34"
                Click="Next_Click" ToolTip="Next" />
      </StackPanel>

      <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#98989f"
                 TextWrapping="Wrap" Margin="0,18,0,0" />
    </StackPanel>

    <Grid Grid.Column="1">
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="0,56,48,120">
        <StackPanel x:Name="LinesPanel" />
      </ScrollViewer>

      <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Content="&#xE711;"
              FontFamily="Segoe MDL2 Assets" FontSize="12" Width="32" Height="28"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
              Click="Close_Click" ToolTip="Close (Esc)" />
    </Grid>
  </Grid>
</Window>
