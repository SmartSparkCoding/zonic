<Window x:Class="Zonic.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new" Height="560" Width="600" MinHeight="320" MinWidth="440"
        WindowStyle="None" Background="#1c1c1e" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" Background="#1c1c1e">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="56" />
    </Grid.RowDefinitions>

    <Border x:Name="Header" Grid.Row="0" Background="#1c1c1e" MouseLeftButtonDown="Header_MouseDown">
      <Grid Margin="20,0,12,0">
        <TextBlock x:Name="HeaderText" Text="What's new" FontSize="14" FontWeight="SemiBold"
                   Foreground="#f2f2f7" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" Content="&#xE711;"
                FontFamily="Segoe MDL2 Assets" FontSize="12" Width="32" Height="28"
                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
      <StackPanel x:Name="NotesPanel" />
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="24,0">
      <Button x:Name="ReleaseButton" Content="View release" Width="120" Height="28"
              HorizontalAlignment="Left" VerticalAlignment="Center" Click="Release_Click" />
      <Button x:Name="NiceButton" Content="Nice" Width="90" Height="28"
              HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click"
              IsDefault="True" />
    </Grid>
  </Grid>
</Window>
