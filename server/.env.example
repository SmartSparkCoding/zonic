# Copy to .env and edit. install.sh does this for you and fills in the password hash.

# The port Caddy listens on when there is no domain below. Point your port forward or
# your tunnel at this. Pick something other than 8080 if the box already uses it.
ZONIC_PUBLIC_PORT=6769

# Set this to a hostname that resolves to this box and Caddy gets a real certificate on
# 443 by itself, forwarding 80 to the challenge. ZONIC_PUBLIC_PORT is ignored when this is
# set, because certificate validation only ever arrives on 80 or 443. Leave it empty to
# serve plain http on ZONIC_PUBLIC_PORT and put a tunnel in front instead.
ZONIC_DOMAIN=

# The loopback port the session streams on. Nothing outside the box should reach it.
ZONIC_STREAM_PORT=8090

# The loopback port the settings app listens on.
ZONIC_GATE_PORT=8091

# Minutes of nobody being connected before the session is shut down.
ZONIC_IDLE_MINUTES=10

# The login Caddy asks for. The password itself is never stored, only its bcrypt hash,
# which install.sh writes into the rendered Caddyfile.
ZONIC_USER=jacob

# Container name, and the caps that keep the session from eating the whole box.
ZONIC_CONTAINER=zonic-session
ZONIC_SESSION_MEMORY=1400m
ZONIC_SESSION_CPUS=1.8

TZ=Europe/London
