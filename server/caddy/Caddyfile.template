# The front door. install.sh runs caddy/render.py over this and writes /etc/caddy/Caddyfile.
#
# Two modes, chosen by whether ZONIC_DOMAIN is set in .env:
#
#   no domain   the site address is a bare port and TLS is off, so something in front has
#               to provide HTTPS (a tunnel), or you live with plain http.
#   domain      the site address is the hostname, Caddy gets a real certificate on 443 and
#               keeps 80 for the challenge and the redirect. Forward both ports to the box.
#
# Everything is behind the password, including /settings. The stream is a WebSocket, so
# the proxy has to stop buffering and let it sit open.

{
	admin off
	__AUTO_HTTPS__
}

__SITE_ADDRESS__ {
	basic_auth {
		__USER__ __HASH__
	}

	@gate path /settings /settings/ /zonic-api/* /healthz
	handle @gate {
		encode zstd gzip
		reverse_proxy 127.0.0.1:__GATE_PORT__
	}

	handle {
		reverse_proxy 127.0.0.1:__STREAM_PORT__ {
			# -1 means flush every write straight through. Without it the stream stalls.
			flush_interval -1
		}
	}

	# A stopped session answers nothing, so a 5xx is the signal to wake it. The gate
	# starts the container and hands back a page that reloads itself until it is up.
	handle_errors {
		@down expression {http.error.status_code} >= 500
		handle @down {
			rewrite * /wake
			reverse_proxy 127.0.0.1:__GATE_PORT__
		}
		respond "upstream error {http.error.status_code}" {http.error.status_code}
	}
}
